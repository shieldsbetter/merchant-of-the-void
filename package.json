        "format:check": "prettier --check ."
    },
    "dependencies": {
        "@fastify/static": "^8.0.0",
        "@shieldsbetter/planet": "^0.1.0",
        "fastify": "^5.2.1",
        "mustache": "^4.2.0"
    },
    "devDependencies": {
        "@iconify-json/game-icons": "^1.2.4",
        "concurrently": "^9.1.2",
        "prettier": "^3.10.1",
        "qrcode": "^1.5.4",
        "vite": "^6.0.11"
    }
}
