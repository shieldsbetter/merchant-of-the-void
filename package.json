{
    "name": "trade",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "concurrently -n api,web -c cyan,magenta \"node scripts/api.js\" \"vite\"",
        "build": "vite build",
        "start": "node scripts/start.js",
